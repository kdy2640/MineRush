  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uAC8C\uC784\uC740 \uAC04\uB2E8\uD569\uB2C8\uB2E4!\n\uCC44\uAD74 \uC138\uC158\uC774
    \uC2DC\uC791\uB418\uBA74, \uB9C8\uC6B0\uC2A4\uB97C \uAD11\uC11D \uC704\uB85C
    \uC6C0\uC9C1\uC5EC\uC11C \uCC44\uAD74\uD558\uC138\uC694!\n\n\uB9C8\uC6B0\uC2A4\uB97C
    \uB530\uB77C \uC6D0\uC774 \uC6C0\uC9C1\uC785\uB2C8\uB2E4.\n\uC774 \uC6D0\uC774
    \uCC44\uAD74\uB418\uB294 \uBC94\uC704\uC774\uBA70, \uBC94\uC704 \uC548\uC758
    \uAD11\uC11D\uC744 \uC790\uB3D9\uC73C\uB85C \uCC44\uAD74\uD569\uB2C8\uB2E4.\n\n\uC6B0\uCE21
    \uC0C1\uB2E8\uC758 \uD0C0\uC774\uBA38\uAC00 0\uC774 \uB418\uBA74 \uCC44\uAD74
    \uC138\uC158\uC774 \uC885\uB8CC\uB429\uB2C8\uB2E4."
  m_isRightToLeft: 0
